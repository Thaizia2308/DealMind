# =====================================================================
# DealMind environment variables
# Copy this file to ".env" in the project root and fill in your values:
#     Copy-Item .env.example .env        (Windows PowerShell)
# NEVER commit .env or put real keys in this example file.
# =====================================================================

# ---------- Hindsight (persistent memory) ----------
# Option A - Hindsight Cloud (hosted by Vectorize): put your API key here and leave HINDSIGHT_BASE_URL empty.
# Get it by signing up at https://ui.hindsight.vectorize.io/signup
HINDSIGHT_API_KEY=hsk_837d3d3996397e798ab9b03dda7aa4b8_fb74862851f01d8f

# Option B - self-hosted Hindsight server (for example Docker on port 8888):
#   HINDSIGHT_BASE_URL=http://localhost:8888
# Leave empty to use Hindsight Cloud. (An API key is only needed if your server requires one.)
HINDSIGHT_BASE_URL=

# Prefix for the per-customer memory banks DealMind creates in Hindsight.
HINDSIGHT_BANK_PREFIX=dealmind
# false = wait until Hindsight has processed each interaction (recommended for demos).
# true  = send in the background (faster saves, but memory may lag a few seconds).
HINDSIGHT_RETAIN_ASYNC=false
# Seconds to wait for Hindsight (memory extraction can take a while).
HINDSIGHT_TIMEOUT=120

# ---------- Backend ----------
# SQLite file, created automatically. In production use a hosted Postgres URL instead
# (for example postgresql://user:password@host:5432/dbname).
DATABASE_URL=sqlite:///./dealmind.db
# Browser origin(s) allowed to call the API (CORS). Comma-separated for several.
# Local development: http://localhost:5173     Production: your deployed frontend URL.
FRONTEND_URL=http://localhost:5173

# ---------- Frontend ----------
# Public URL of the backend. Leave EMPTY for local development (the Vite dev server proxies /api).
# Production example: https://your-backend.onrender.com   (no trailing slash)
# NOTE: Vite bakes this in at BUILD time - redeploy the frontend after changing it.
VITE_API_URL=
